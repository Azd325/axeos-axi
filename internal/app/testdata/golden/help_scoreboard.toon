exit: 0
command: scoreboard
description: "Best-difficulty shares, highest first, at most 20; default columns rank,difficulty,ntime; --fields replaces the row columns; ntime is the block-header time in Unix seconds"
flags:
  host: "--host <address>; without it AXEOS_HOST, then the saved host (axeos-axi host --help), and the result then prints saved_host; one of the three is required; one miner; HTTP unless a scheme is supplied"
  fields: "--fields <name,...>; default compact view; replaces data fields; accepts view fields and exact API field names"
  json: "--json; prints the result as one JSON document with the same fields, values and help lines; errors as one JSON object with code, message and help; the exit code is unchanged"
  help: "--help; no network request"
  version: "-v, -V, --version; bare version, or with --json one object {\"version\":\"...\"}; no network request"
timeout_s: 4
view_fields: "rank,difficulty,ntime,job_id,extranonce2,nonce,version_bits"
private_fields: "info/home/asic: stratumUser,fallbackStratumUser,pools,ssid,macAddr are explicit opt-ins"
examples[3]: axeos-axi scoreboard --host 192.0.2.10,"axeos-axi scoreboard --host 192.0.2.10 --fields rank,difficulty,nonce",axeos-axi scoreboard --help
